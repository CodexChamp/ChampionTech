@page
@{
    ViewData["Title"] = "Credentials | Rylan Champion";
    ViewData["MetaDescription"] = "Credentials and background for Rylan Champion, freelance software developer building modern business software.";
}

<canvas id="fireworks-background" class="fireworks-canvas" aria-hidden="true"></canvas>

<section class="hero-section credentials-hero">
    <div class="container site-shell narrow-section">
        <p class="eyebrow">Credentials</p>
        <h1>Modern software thinking, backed by a computer science education.</h1>
        <p class="hero-lead">
            I combine a computer science foundation with hands-on work building practical internal tools, data workflows, automation, and business software.
        </p>
    </div>
</section>

<section class="content-section section-muted">
    <div class="container site-shell credentials-grid">
        <article class="credential-card">
            <p class="section-kicker">Education</p>
            <h2>Bachelor of Science in Computer Science</h2>
            <p class="credential-school">Southern New Hampshire University</p>
            <p class="section-text">
                My degree gives me a strong foundation in software development, problem solving, databases, and building systems that are designed to hold up as a business grows.
            </p>
        </article>
        <article class="credential-card">
            <p class="section-kicker">How I Apply It</p>
            <h2>Useful technology for real operations.</h2>
            <p class="section-text">
                The value is not just knowing the technical side. It is using current tools and fresh ideas to help businesses replace slow, fragile workflows with software that is easier to use and easier to improve.
            </p>
        </article>
    </div>
</section>

<section class="content-section">
    <div class="container site-shell two-column-section">
        <div class="section-heading">
            <p class="section-kicker">What Clients Can Expect</p>
            <h2>A clear path from old process to modern tool.</h2>
        </div>
        <ul class="benefit-list">
            <li>Thoughtful software design grounded in computer science fundamentals.</li>
            <li>Modern alternatives to spreadsheets, Access databases, and disconnected manual processes.</li>
            <li>Practical tools that work for the people using them every day.</li>
            <li>Clear communication about what is worth building and why.</li>
        </ul>
    </div>
</section>

<section class="content-section contact-section" id="contact">
    <div class="container site-shell">
        <div class="contact-card">
            <div>
                <p class="section-kicker">Start a Conversation</p>
                <h2>Ready to bring a process up to date?</h2>
                <p class="section-text">Tell me what is slowing the team down, and we can talk through a modern, practical way to improve it.</p>
            </div>
            <div class="contact-actions">
                <button class="btn btn-primary btn-lg" type="button" data-email-trigger="credentials">Get in Touch</button>
            </div>
        </div>
    </div>
</section>

<div class="email-choice-backdrop" id="email-choice-backdrop" hidden></div>
<div class="email-choice-modal" id="email-choice-modal" role="dialog" aria-modal="true" aria-labelledby="email-choice-title" hidden>
    <button class="email-choice-close" type="button" id="email-choice-close" aria-label="Close contact options">&times;</button>
    <p class="section-kicker">Contact Options</p>
    <h2 id="email-choice-title">How would you like to send your message?</h2>
    <p class="section-text">Choose Gmail, Outlook, or your default email app.</p>
    <div class="email-choice-actions">
        <a class="email-choice-option" href="https://mail.google.com/mail/?view=cm&amp;fs=1&amp;to=rylanchamp12@gmail.com" target="_blank" rel="noreferrer">
            <span class="email-choice-name">Use Gmail</span>
            <span class="email-choice-note">Open a new Gmail compose window</span>
        </a>
        <a class="email-choice-option" href="https://outlook.office.com/mail/deeplink/compose?to=rylanchamp12@gmail.com" target="_blank" rel="noreferrer">
            <span class="email-choice-name">Use Outlook</span>
            <span class="email-choice-note">Open a new Outlook compose window</span>
        </a>
        <a class="email-choice-option" href="mailto:rylanchamp12@gmail.com">
            <span class="email-choice-name">Use Default Email App</span>
            <span class="email-choice-note">Open the email app already set on this device</span>
        </a>
    </div>
</div>
